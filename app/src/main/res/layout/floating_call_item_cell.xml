<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:background="@drawable/in_call_item_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Status Tag: (Hold), (Ringing), (Received), (Calling) -->
    <TextView
        android:id="@+id/floating_item_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="(Ringing)"
        android:textColor="#34D399"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Phone Number -->
    <TextView
        android:id="@+id/floating_item_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/floating_item_tag"
        android:layout_toStartOf="@id/floating_item_timer"
        android:layout_alignParentTop="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="+8801350748310"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Duration Timer: (00:15) -->
    <TextView
        android:id="@+id/floating_item_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/floating_item_btn_hangup"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:text=""
        android:textColor="#34D399"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/floating_item_substatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Individual Call Hangup Button (Small Red Circle with white phone disconnect icon) -->
    <FrameLayout
        android:id="@+id/floating_item_btn_hangup"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_bubble_circle_red"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/phone_disconnect"
            android:tint="#FFFFFF"
            app:tint="#FFFFFF" />
    </FrameLayout>

</RelativeLayout>
